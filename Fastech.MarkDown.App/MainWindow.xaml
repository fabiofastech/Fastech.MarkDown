<Window x:Class="Fastech.MarkDown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Fastech Markdown Viewer" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/fastech.ico">

    <Window.Resources>
        <!-- Colori brand Fastech -->
        <SolidColorBrush x:Key="BrandOrange"     Color="#F0A000"/>
        <SolidColorBrush x:Key="BrandOrangeDark" Color="#C87D00"/>
        <SolidColorBrush x:Key="BrandWarm"       Color="#FFF4E0"/>
        <SolidColorBrush x:Key="BrandWarmBorder" Color="#E8C060"/>
        <SolidColorBrush x:Key="BrandText"       Color="#2C1A00"/>
        <SolidColorBrush x:Key="BrandWhite"      Color="#FFFFFF"/>

        <!-- Stile bottone toolbar -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource BrandWhite}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="12,5"/>
            <Setter Property="Margin"           Value="1,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC7A00"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF50"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A86400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile TreeViewItem — solo colori, non sostituisce il template default -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding"    Value="3,4"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandOrange}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="False"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FFE5A0"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar con gradiente brand Fastech -->
        <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="{StaticResource BrandOrangeDark}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F5A800" Offset="0"/>
                    <GradientStop Color="#E09000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="False" Height="46">
                <!-- Logo -->
                <Image DockPanel.Dock="Left" Source="Assets/logo.png"
                       Height="34" Margin="10,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Separator DockPanel.Dock="Left" Background="#FFFFFF40" Width="1" Margin="0,8"/>

                <!-- Bottoni -->
                <Button DockPanel.Dock="Left" x:Name="BtnOpenFolder"
                        Content="📁  Apri Cartella" Style="{StaticResource ToolbarButton}"
                        Click="BtnOpenFolder_Click"/>
                <Button DockPanel.Dock="Left" x:Name="BtnOpenFile"
                        Content="📄  Apri File" Style="{StaticResource ToolbarButton}"
                        Click="BtnOpenFile_Click"/>
                <Separator DockPanel.Dock="Left" Background="#FFFFFF40" Width="1" Margin="4,8"/>
                <Button DockPanel.Dock="Left" x:Name="BtnRefresh"
                        Content="🔄  Aggiorna" Style="{StaticResource ToolbarButton}"
                        Click="BtnRefresh_Click"/>
                <Separator DockPanel.Dock="Left" Background="#FFFFFF40" Width="1" Margin="4,8"/>
                <Button DockPanel.Dock="Left" x:Name="BtnToggleTree"
                        Content="☰  Pannello" Style="{StaticResource ToolbarButton}"
                        Click="BtnToggleTree_Click"/>
            </DockPanel>
        </Border>

        <!-- Layout: tree + splitter + viewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="250" MinWidth="0"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- File tree -->
            <Border Grid.Column="0" Background="{StaticResource BrandWarm}"
                    BorderBrush="{StaticResource BrandWarmBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Header panel -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource BrandOrange}"
                            Padding="10,6">
                        <TextBlock Text="FILE EXPLORER" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TreeView x:Name="FileTreeView"
                              Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="FileTreeView_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              Padding="4,4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BrandWarmBorder}" Cursor="SizeWE"/>

            <!-- Viewer -->
            <wv2:WebView2 x:Name="WebView" Grid.Column="2"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#2C1A00" Padding="8,4">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="Assets/logo.png"
                       Height="18" Margin="8,0,4,0" Opacity="0.7"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="StatusText" Foreground="#FFC850" FontSize="12"
                           Text="Pronto — apri una cartella o un file Markdown"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
